# TypeSafe (the Amp project currently provides TYPESAFE_AI_API_KEY)
TYPESAFE_AI_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_INPUT_USD_PER_MILLION=0
TYPESAFE_OUTPUT_USD_PER_MILLION=0

# Any OpenAI-compatible general-purpose LLM endpoint
OPEN_ROUTER_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0

# Benchmark controls
BENCH_CONCURRENCY=4
BENCH_REPEAT_COUNT=5
