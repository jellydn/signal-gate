{
  "name": "signal-gate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "tsx src/cli.ts",
    "bench:smoke": "tsx src/cli.ts --smoke --engines rules",
    "serve": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.5.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=20"
  }
}
